# Built application files
/frontend/*.apk
/frontend/*.ap_
/frontend/*.aab

# Files for the ART/Dalvik VM
/frontend/*.dex

# Java class files
/frontend/*.class

# Generated files
/frontend/bin/
/frontend/gen/
/frontend/out/

# Gradle files
/frontend/.gradle/
/frontend/build/

# Local configuration file (sdk path, etc)
/frontend/local.properties

# Proguard folder generated by Eclipse
/frontend/proguard/

# Log Files
/frontend/*.log

# Android Studio Navigation editor temp files
/frontend/.navigation/

# Android Studio captures folder
/frontend/captures/

# IntelliJ
/frontend/*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
/frontend/.externalNativeBuild

# Google Services (e.g. APIs or Firebase)
/frontend/google-services.json

# Freeline
/frontend/freeline.py
/frontend/freeline/
/frontend/freeline_project_description.json

# fastlane
/frontend/fastlane/report.xml
/frontend/fastlane/Preview.html
/frontend/fastlane/screenshots
/frontend/fastlane/test_output
/frontend/fastlane/readme.md